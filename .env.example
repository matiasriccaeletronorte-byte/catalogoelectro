MONGODB_URI=mongodb://localhost:27017/catalogo_electronorte
NEXT_PUBLIC_STORE_NAME=Electronorte
ADMIN_PASSWORD=cambiar-esta-clave
UPLOAD_DIR=./uploads

# Fotos en Supabase Storage (en Vercel son obligatorias; sin estas tres variables se usa la carpeta local UPLOAD_DIR)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=productos

# Contabilium (solo para traer artículos; el email y la API Key se cargan SOLO acá y en tu terminal)
CONTABILIUM_EMAIL=
CONTABILIUM_API_KEY=
